# ============================================
# SESH / MoviePlatform
# Local lightweight production runtime
# ============================================


# ============================================
# Application
# ============================================

# Используем production Node runtime:
# - Next standalone
# - compiled NestJS
# - без watchers
# - без Turbopack dev server
NODE_ENV=production

# При этом приложение НЕ считается настоящим production.
APP_ENV=staging
NEXT_PUBLIC_APP_ENV=staging

APP_NAME=SESH

APP_URL=http://localhost:3000
API_URL=http://localhost:4000

NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1


# ============================================
# PostgreSQL
# ============================================

POSTGRES_USER=movieplatform
POSTGRES_PASSWORD=movieplatform_dev
POSTGRES_DB=movieplatform

# Эти значения используются с Windows/host.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

DATABASE_URL=postgresql://movieplatform:movieplatform_dev@localhost:5432/movieplatform?schema=public


# ============================================
# Redis
# ============================================

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379


# ============================================
# JWT
# ============================================

JWT_SECRET=your-super-secret-jwt-key-change-in-production

JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d


# ============================================
# MinIO
# ============================================

MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123

MINIO_ENDPOINT=http://localhost:9000

MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123

MINIO_BUCKET_VIDEOS=videos
MINIO_BUCKET_THUMBNAILS=thumbnails
MINIO_BUCKET_DOCUMENTS=documents
MINIO_BUCKET_AVATARS=avatars

# URL accessible by browser
MINIO_PUBLIC_ENDPOINT=http://localhost:3000/minio

# Used by Next image configuration
NEXT_PUBLIC_MINIO_URL=http://localhost:9000


# ============================================
# Video Processing
# ============================================

VIDEO_PROCESSING_CONCURRENCY=1


# ============================================
# EdgeCenter
# ============================================

EDGECENTER_API_KEY=your-edgecenter-api-key

EDGECENTER_CDN_HOSTNAME=your-cdn-hostname.edgecenter.ru

EDGECENTER_API_BASE_URL=https://api.edgecenter.ru/streaming

EDGECENTER_WEBHOOK_SECRET=your-webhook-secret

EDGECENTER_CDN_SECRET=your-cdn-secret-key


# ============================================
# Bunny CDN - optional
# ============================================

# BUNNY_API_KEY=
# BUNNY_STREAM_LIBRARY_ID=
# BUNNY_STREAM_API_KEY=
# BUNNY_CDN_HOSTNAME=
# BUNNY_STORAGE_ZONE=
# BUNNY_STORAGE_API_KEY=
# BUNNY_TOKEN_AUTH_KEY=
# BUNNY_WEBHOOK_SECRET=


# ============================================
# SMTP / Mailhog
# ============================================

SMTP_HOST=localhost
SMTP_PORT=1025

SMTP_SECURE=false

SMTP_USER=
SMTP_PASSWORD=

SMTP_FROM_NAME=SESH
SMTP_FROM_EMAIL=noreply@movieplatform.local


# ============================================
# YooKassa
# ============================================

YOOKASSA_SHOP_ID=your-shop-id

YOOKASSA_SECRET_KEY=your-secret-key

YOOKASSA_WEBHOOK_SECRET=your-webhook-secret

YOOKASSA_RETURN_URL=http://localhost:3000/payment/success

YOOKASSA_CANCEL_URL=http://localhost:3000/payment/cancel


# ============================================
# SBP
# ============================================

SBP_MERCHANT_ID=your-merchant-id

SBP_API_KEY=your-api-key


# ============================================
# Security
# ============================================

BCRYPT_ROUNDS=12

RATE_LIMIT_WINDOW_MS=60000

RATE_LIMIT_MAX_REQUESTS=100

CORS_ORIGINS=http://localhost:3000,http://localhost:4000


# ============================================
# Logging
# ============================================

# В dev у тебя было debug.
# Теперь ставим info, чтобы не плодить лишние логи.
LOG_LEVEL=info

SENTRY_DSN=

SENTRY_ENVIRONMENT=staging


# ============================================
# Optional Admin Tools
# ============================================

PGADMIN_EMAIL=admin@movieplatform.local

PGADMIN_PASSWORD=admin123


# ============================================
# Feature Flags
# ============================================

ENABLE_REGISTRATION=true

ENABLE_PARTNER_PROGRAM=true

ENABLE_STORE=true

ENABLE_BONUSES=true

# Локально тестовые платежи разрешены.
ENABLE_TEST_PAYMENTS=true

NEXT_PUBLIC_ENABLE_TEST_PAYMENTS=true


# ============================================
# Age Verification
# ============================================

AGE_VERIFICATION_PROVIDER=manual

AGE_VERIFICATION_API_KEY=


# ============================================
# Content Delivery
# ============================================

CDN_URL=http://localhost:9000

SIGNED_URL_EXPIRY_HOURS=4